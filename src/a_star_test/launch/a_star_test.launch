<launch>
    <param name="use_sim_time" value="true" />
    <node pkg="a_star_test" type="a_star_test" name="a_star_test" output="screen">
        <param name="base_frame" type="string" value="base_link"/>
        <param name="world_frame" type="string" value="map"/>
        <param name="inflation_radius" type="double" value="0.3"/>
        <param name="dis_occ" type="double" value="0.8"/><!--距离最近障碍物距离小于这个阈值，则不采用这个待选栅格-->
        <param name="map_topic" type="string" value="/map"/>
        <param name="goal_topic" type="string" value="/move_base_simple/goal"/>

    </node>
     <node pkg="rviz" type="rviz" name="rviz" args="-d $(find a_star_test)/rviz/yq_mpc.rviz"/>




</launch>
